VH.headerLines = 60

function VH.blame(err, body)
    local n
    for digits in tostring(err):gmatch(":(%d+):") do n = tonumber(digits) end
    if not n or type(body) ~= "string" then return nil end
    local lines = {}
    for line in (body .. "\n"):gmatch("([^\n]*)\n") do
        lines[#lines + 1] = line
    end
    if not lines[n] then
        return "payload:" .. n .. " (out of range, payload has " .. #lines .. " lines)"
    end
    local out = { "payload:" .. n .. " source:" .. (n - VH.headerLines) .. " of " .. #lines }
    for i = math.max(1, n - 2), math.min(#lines, n + 2) do
        out[#out + 1] = (i == n and ">> " or "   ") .. i .. ": " .. lines[i]:sub(1, 160)
    end
    return table.concat(out, "\n")
end

function VH.report(text, blame)
    if type(VH.request) ~= "function" then return end
    pcall(function()
        VH.request({
            Url = "https://www.vysehub.net/api/roblox/heartbeat",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                sessionId = VH.sessionId or "unknown",
                key = VH.key or "unknown",
                hwid = VH.hwid or "",
                clientError = tostring(text):sub(1, 400),
                blame = blame and tostring(blame):sub(1, 400) or nil,
            }),
        })
    end)
end

local function normalize(raw)
    if type(raw) ~= "table" then return nil end
    local b = raw.Body or raw.body or raw.Content or raw.content
    if type(b) ~= "string" then b = tostring(b or "") end
    local status = tonumber(raw.StatusCode or raw.statusCode or raw.status_code
        or raw.Status or raw.status or raw.code) or 0
    if status == 0 and #b > 0 then status = 200 end
    local success = raw.Success
    if success == nil then success = raw.success end
    if success == nil then success = (status >= 200 and status < 300) end
    return {
        body = b,
        status = status,
        success = success and true or false,
        headers = raw.Headers or raw.headers,
    }
end

local res, lastErr
for attempt = 1, 3 do
    local ok, raw = pcall(VH.request, {
        Url = "https://www.vysehub.net/api/roblox/script",
        Method = "POST",
        Headers = headers,
        Body = body,
    })
    if ok then
        res = normalize(raw)
        if res then
            VH.stage("H", "http " .. res.status .. " len=" .. #res.body .. " try=" .. attempt)
            break
        end
        lastErr = "response was " .. type(raw)
    else
        lastErr = tostring(raw)
    end
    VH.stage("H", "attempt " .. attempt .. " failed: " .. tostring(lastErr))
    if attempt < 3 then pcall(function() task.wait(attempt) end) end
end

if not res then
    VH.out("[VyseHub] via " .. tostring(VH.requestName) .. " error " .. tostring(lastErr))
    VH.out("[VyseHub] caps " .. VH.caps())
    VH.kick("[VyseHub] Unable to reach verification servers. (E-102)")
    return
end

if not res.success or res.status ~= 200 then
    local okJson, info = pcall(function() return HttpService:JSONDecode(res.body) end)
    local msg = (okJson and type(info) == "table" and info.message)
        or ("Invalid or expired license key. (HTTP " .. tostring(res.status) .. ")")
    VH.kick("[VyseHub] " .. tostring(msg))
    return
end

local trimmed = (res.body or ""):gsub("^%s+", "")

if string.sub(trimmed, 1, 1) == "{" then
    local okJson, info = pcall(function() return HttpService:JSONDecode(res.body) end)
    if okJson and type(info) == "table" and info.success == false then
        VH.kick("[VyseHub] " .. tostring(info.message or "Access denied."))
        return
    end
end

if #trimmed == 0 then
    VH.kick("[VyseHub] Server returned an empty script. (E-103)")
    return
end

local runToken = string.match(res.body, "^%-%-%[%[VH:(%x+)%]%]")

if not runToken and type(res.headers) == "table" then
    runToken = res.headers["X-Run-Token"] or res.headers["x-run-token"] or res.headers["X-RUN-TOKEN"]
end

if type(res.headers) == "table" then
    VH.sessionId = res.headers["X-Session-Id"] or res.headers["x-session-id"]
end

VH.stage("I", "token=" .. tostring(runToken) .. " session=" .. tostring(VH.sessionId))

if runToken then
    VH.env.__vyse_run = runToken
    _G.__vyse_run = runToken
end

local chunk, compileErr
do
    local okLoad, a, b = pcall(loadstring, res.body)
    if okLoad then
        chunk, compileErr = a, b
    else
        compileErr = a
    end
end
if not chunk then
    VH.out("[VyseHub] compile " .. tostring(compileErr))
    local blame = VH.blame(compileErr, res.body)
    VH.out("[VyseHub] blame " .. tostring(blame))
    VH.report("E-104 " .. tostring(compileErr), blame)
    VH.kick("[VyseHub] Script failed to compile. (E-104)\n" .. tostring(compileErr):sub(1, 180)
        .. (VH.debug and blame and ("\n" .. blame) or ""))
    return
end

do
    local realReq = VH.request
    local function guard(req)
        local url = req and (req.Url or req.url)
        if url and string.find(url, "webhook", 1, true) and not VH.internal then
            return { Success = false, StatusCode = 403, Body = "Access Denied" }
        end
        return realReq(req)
    end
    VH.internal = false
    VH.env.SetInternalRequest = function(state) VH.internal = state and true or false end
    pcall(function()
        if type(VH.env.request) == "function" then VH.env.request = guard end
        if type(VH.env.http_request) == "function" then VH.env.http_request = guard end
        if type(rawget(_G, "request")) == "function" then _G.request = guard end
        if type(rawget(_G, "http_request")) == "function" then _G.http_request = guard end
        if syn and type(syn.request) == "function" then syn.request = guard end
    end)
    VH.stage("D", "webhook guard armed")
end

