LPH_NO_UPVALUES = function(...) return ... end
LPH_NO_VIRTUALIZE = function(...) return ... end

LPH_NO_VIRTUALIZE(function()

    -- ── 1. ANTI-DUMPER & GC FILTER ──
    local function setupAntiDumper()
        local hidden_tables = {}
        local original_getgc = getgc

        if original_getgc then
            local fake_getgc = function(...)
                local result = original_getgc(...)
                local filtered = {}

                for _, v in pairs(result) do
                    local should_hide = false
                    if typeof(v) == "table" then
                        for _, hidden in pairs(hidden_tables) do
                            if rawequal(v, hidden) then
                                should_hide = true
                                break
                            end
                        end
                    end
                    if not should_hide then
                        table.insert(filtered, v)
                    end
                end
                return filtered
            end

            if hookfunction then
                hookfunction(getgc, fake_getgc)
            elseif setreadonly then
                getgenv().getgc = fake_getgc
            end
        end
        return hidden_tables
    end

    -- ── 2. ANTI-DEBUG & DECOMPILER FREEZE ──
    local function setupAntiDebug()
        local decompiler_funcs = {
            "decompile", "disassemble", "getbytecode",
            "dumpstring", "dumptable", "saveinstance"
        }

        for _, func_name in pairs(decompiler_funcs) do
            if getgenv()[func_name] then
                getgenv()[func_name] = function(...)
                    task.wait(9e9)
                end
            end
        end
    end

    -- ── 3. MEMORY PROTECTION & DECOYS ──
    local function setupMemoryProtection()
        local decoys = {}
        for i = 1, 30 do
            decoys[i] = {
                Detected = function() return true end,
                Kill = function() game.Players.LocalPlayer:Kick("[VyseHub] Security anomaly detected.") end,
                Variables = {},
                AntiCheat = true,
                Active = true
            }
        end

        getgenv().FAKE_KEY = "fake_key_" .. tostring(math.random(100000, 999999))
        getgenv().FAKE_HWID = "fake_hwid_" .. tostring(math.random(100000, 999999))
        return decoys
    end

    -- ── 4. INTEGRITY CHECK & CHECKSUMS ──
    local function createIntegrityCheck()
        local checksums = {}
        local critical_functions = {}

        local function calculateChecksum(func)
            if typeof(func) == "function" and debug and debug.getinfo then
                local info = debug.getinfo(func)
                return tostring(info.source) .. tostring(info.linedefined)
            end
            return "valid"
        end

        local function addCriticalFunction(name, func)
            critical_functions[name] = func
            checksums[name] = calculateChecksum(func)
        end

        local function verifyIntegrity()
            for name, func in pairs(critical_functions) do
                local current_checksum = calculateChecksum(func)
                if checksums[name] ~= current_checksum and checksums[name] ~= "valid" then
                    game.Players.LocalPlayer:Kick("[VyseHub] Integrity violation: " .. name)
                    return false
                end
            end
            return true
        end
        return addCriticalFunction, verifyIntegrity
    end

    -- ── 5. ANTI-HOOK SENTRY ──
    local function setupAntiHook()
        local original_functions = {}
        local hook_detectors = {
            "hookfunction", "hookmetamethod", "newcclosure",
            "replaceclosure"
        }

        for _, func_name in pairs(hook_detectors) do
            if getgenv()[func_name] then
                original_functions[func_name] = getgenv()[func_name]
            end
        end

        task.spawn(function()
            while true do
                task.wait(3)
                for func_name, original in pairs(original_functions) do
                    local current = getgenv()[func_name]
                    if current and current ~= original then
                        game.Players.LocalPlayer:Kick("[VyseHub] Hook anomaly detected: " .. func_name)
                        break
                    end
                end
            end
        end)
    end

    -- ── 6. CONSOLE SENSITIVE DATA FILTER ──
    local function filterConsole(origFunc)
        return function(...)
            local args = {...}
            local str = string.lower(table.concat(args, " "))
            if string.find(str, "vyse") or string.find(str, "github") or string.find(str, "whitelist") then
                return
            end
            return origFunc(...)
        end
    end

    if hookfunction then
        pcall(function()
            hookfunction(print, filterConsole(print))
            hookfunction(warn, filterConsole(warn))
        end)
    end

    -- ── 7. UI DUMP BLOCKER ──
    pcall(function()
        game.DescendantAdded:Connect(function(c)
            if c and (c:IsA('TextLabel') or c:IsA('TextButton') or c:IsA('Message')) then
                if string.find(string.lower(c.Text), 'https://') and string.find(string.lower(c.Text), 'vyse') then
                    c:Destroy()
                end
            end
        end)

        game.CoreGui.ChildAdded:Connect(function(c)
            if string.lower(c.Name) == 'devconsolemaster' or string.find(string.lower(c.Name), "dex") then
                task.wait(0.1)
                c:Destroy()
            end
        end)
    end)

    local function validateEnvironment()
        local required_globals = {"game", "workspace", "script", "task"}
        for _, global_name in pairs(required_globals) do
            if not getgenv()[global_name] then return false, "Missing global: " .. global_name end
        end
        if not game.PlaceId or game.PlaceId == 0 then return false, "Invalid place environment" end
        return true, "OK"
    end

    local function initializeProductions()
        local valid, msg = validateEnvironment()
        if not valid then
            game.Players.LocalPlayer:Kick("[VyseHub] Environment check failed: " .. msg)
            return false
        end

        setupAntiDumper()
        setupAntiDebug()
        setupMemoryProtection()
        setupAntiHook()

        local addCriticalFunction, verifyIntegrity = createIntegrityCheck()
        task.spawn(function()
            while true do
                task.wait(5)
                if not verifyIntegrity() then break end
            end
        end)
        return true
    end

    local isInternalRequest = false

    local oldReq
    local reqFunc = syn and syn.request or http_request or request or (http and http.request)
    if hookfunction and reqFunc then
        oldReq = hookfunction(reqFunc, newcclosure(function(newreq)
            if newreq.Url:find("webhook") then
                if not isInternalRequest then
                    return {Success = false, StatusCode = 403, Body = "Access Denied"}
                end
            end
            return oldReq(newreq)
        end))
    end

    getgenv().SetInternalRequest = function(state) isInternalRequest = state end
    if setreadonly and getrawmetatable then pcall(function() setreadonly(getrawmetatable(game), false) end) end

    local function executeProtected(main_function)
        if not initializeProductions() then return end
        task.wait(math.random(50, 200) / 1000)
        local success, error_msg = pcall(main_function)
        if not success then warn("Execution failed") end
    end

    return executeProtected
end)()

-- ==============================================================================
-- RUNTIME AUTHENTICATION & SCRIPT LOADING ENGINE
-- ==============================================================================

local HttpService = game:GetService("HttpService")
local RbxAnalyticsService = game:GetService("RbxAnalyticsService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

task.wait(math.random(50, 200) / 1000)

local hwid = RbxAnalyticsService:GetClientId()
local currentPlaceId = game.PlaceId

local gameInfoSuccess, gameInfo = pcall(function()
    return MarketplaceService:GetProductInfo(currentPlaceId)
end)
local currentGameTitle = (gameInfoSuccess and gameInfo and gameInfo.Name) or "Roblox Game"
-- API Endpoints
local vHost = "vysehub.net"
local verifyUrl = "https://www." .. vHost .. "/api/roblox/verify-key"
local gHost = "raw.githubusercontent.com"
local gamelistUrl = "https://www." .. gHost .. "/SherkMasterHacka/VyseHub/refs/heads/main/GameList.json"

local timestamp = os.time()
local verification_hash = tostring(hwid):reverse() .. tostring(timestamp)

local headers = {
    ["Content-Type"] = "application/json",
    ["Origin"] = "https://www." .. vHost .. "/",
    ["X-Verify"] = verification_hash:sub(1, 16)
}

local userKey = _G.Key or (getgenv and getgenv().Key)
if not userKey or userKey == "" then
    Players.LocalPlayer:Kick("[VyseHub] Missing license key. Please set _G.Key before running.")
    return
end

-- Clear Key out of global memory immediately
_G.Key = nil
if getgenv then getgenv().Key = nil end

local body = {
    key = userKey,
    hwid = hwid,
    timestamp = timestamp,
    verification = verification_hash,
    gameName = currentGameTitle,
    placeId = tostring(currentPlaceId)
}

local requestFunction = syn and syn.request or http_request or request or (http and http.request)
if not requestFunction then
    Players.LocalPlayer:Kick("[VyseHub] Unsupported executor. Missing HTTP request functions.")
    return
end

if getgenv().SetInternalRequest then getgenv().SetInternalRequest(true) end

-- ── 1. SEND KEY TO SERVER FOR VERIFICATION ──
local response = requestFunction({
    Url = verifyUrl,
    Method = "POST",
    Headers = headers,
    Body = HttpService:JSONEncode(body)
})

if response and response.Success then
    local decoded = HttpService:JSONDecode(response.Body)

    -- Check Blacklist Status
    if decoded.blacklist == true then
        Players.LocalPlayer:Kick("[VyseHub] Your HWID is permanently blacklisted.")
        return
    end

    -- 🔴 Check HWID Mismatch Explicitly
    if decoded.hwidMismatch == true or string.find(string.lower(decoded.message or ""), "hwid mismatch") then
        Players.LocalPlayer:Kick("[VyseHub] HWID Mismatch! This key is bound to another device.\nPlease reset your HWID at vysehub.net")
        return
    end

    -- Check Verification Status
    if decoded.success == true then
        
        -- ── 2. FETCH GAMELIST DISPATCHER ──
        local responseGamelist = requestFunction({ Url = gamelistUrl })

        if responseGamelist and responseGamelist.Success then
            local gameData = HttpService:JSONDecode(responseGamelist.Body)
            local scriptLoaded = false

           for gameName, expectedPlaceId in pairs(gameData) do
                if string.find(string.lower(tostring(decoded.data.productName)), string.lower(tostring(gameName))) then

                    if tonumber(expectedPlaceId) == 0 or tonumber(expectedPlaceId) == tonumber(currentPlaceId) then
                        scriptLoaded = true

                        local formattedGameName = string.gsub(gameName, " ", "%%20")
                        local gameScript = "https://" .. gHost .. "/SherkMasterHacka/VyseHub/refs/heads/main/" .. formattedGameName .. ".lua"
                        
                        local loadSuccess, loadError = pcall(function()
                            loadstring(game:HttpGet(gameScript))()
                        end)

                        if not loadSuccess then
                            warn("[VyseHub] Script load failure: " .. tostring(loadError))
                        end

                        break 
                    else
                        Players.LocalPlayer:Kick("[VyseHub] Place ID mismatch. This script cannot be executed here.")
                        return
                    end
                end
            end

            if not scriptLoaded then
                Players.LocalPlayer:Kick("[VyseHub] You do not own a license for this game.")
            end
        else
            Players.LocalPlayer:Kick("[VyseHub] Failed to fetch game database. Please try again.")
        end
    else
        Players.LocalPlayer:Kick("[VyseHub] " .. (decoded.message or "Invalid or expired license key."))
    end
else
    Players.LocalPlayer:Kick("[VyseHub] Unable to reach verification servers. Please check your connection.")
end

if getgenv().SetInternalRequest then getgenv().SetInternalRequest(false) end
