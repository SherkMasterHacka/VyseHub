function VH.out(msg)
    VH.bypass = true
    pcall(VH.rawWarn, msg)
    VH.bypass = false
end

function VH.stage(code, msg)
    VH.stages[#VH.stages + 1] = code
    if VH.debug then
        VH.out("[VH " .. code .. "] " .. tostring(msg))
    end
end

function VH.trail()
    return table.concat(VH.stages, ">")
end

function VH.kick(msg)
    VH.out(msg .. " | trail " .. VH.trail())
    local plr
    pcall(function() plr = game:GetService("Players").LocalPlayer end)
    for _ = 1, 20 do
        if plr then break end
        pcall(function() task.wait(0.1) end)
        pcall(function() plr = game:GetService("Players").LocalPlayer end)
    end
    if plr then pcall(function() plr:Kick(msg) end) end
end

function VH.pick()
    local e = VH.env
    local list = {
        { "request", e.request },
        { "http_request", e.http_request },
        { "request", request },
        { "http_request", http_request },
        { "httprequest", e.httprequest },
        { "syn.request", syn and syn.request },
        { "http.request", http and http.request },
        { "fluxus.request", fluxus and fluxus.request },
        { "krnl.request", krnl and krnl.request },
        { "Drawing.request", nil },
    }
    for i = 1, #list do
        if type(list[i][2]) == "function" then
            return list[i][2], list[i][1]
        end
    end
    return nil, nil
end

function VH.caps()
    local e = VH.env
    local names = { "request", "http_request", "httprequest", "hookfunction",
        "newcclosure", "loadstring", "getgenv", "setreadonly", "getgc", "restorefunction" }
    local out = {}
    for i = 1, #names do
        local n = names[i]
        local v = e[n]
        if v == nil then v = _G[n] end
        out[#out + 1] = n .. "=" .. (type(v) == "function" and "1" or "0")
    end
    out[#out + 1] = "syn=" .. (syn and "1" or "0")
    local exec = "?"
    if type(identifyexecutor) == "function" then
        local okExec, nameExec = pcall(identifyexecutor)
        if okExec and nameExec then exec = tostring(nameExec) end
    end
    out[#out + 1] = "executor=" .. exec
    return table.concat(out, " ")
end

LPH_NO_VIRTUALIZE(function()

    local picked, pickedName = VH.pick()
    VH.request = picked
    VH.requestName = pickedName
    VH.stage("A", "request=" .. tostring(pickedName))

    if not VH.debug then
        local realPrint, realWarn = print, warn
        local function wrap(original)
            return function(...)
                if VH.bypass then return original(...) end
                local n = select("#", ...)
                local args = table.pack(...)
                local ok, hit = pcall(function()
                    local parts = {}
                    for i = 1, n do parts[i] = string.lower(tostring(args[i])) end
                    local text = table.concat(parts, " ")
                    for i = 1, #VH.secrets do
                        if string.find(text, string.lower(VH.secrets[i]), 1, true) then
                            return true
                        end
                    end
                    return false
                end)
                if ok and hit then return end
                return original(...)
            end
        end
        pcall(function()
            VH.env.print = wrap(realPrint)
            VH.env.warn = wrap(realWarn)
        end)
        VH.stage("B", "console filter installed")
    else
        VH.stage("B", "console filter skipped")
    end

    if type(setreadonly) == "function" and type(getrawmetatable) == "function" then
        pcall(function() setreadonly(getrawmetatable(game), false) end)
    end

    pcall(function()
        game.DescendantAdded:Connect(function(c)
            if c and (c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("Message")) then
                local text = string.lower(tostring(c.Text))
                if string.find(text, "https://", 1, true) and string.find(text, "vyse", 1, true) then
                    c:Destroy()
                end
            end
        end)
    end)

    pcall(function()
        game:GetService("CoreGui").ChildAdded:Connect(function(c)
            local name = string.lower(c.Name)
            if name == "devconsolemaster" or string.find(name, "dex", 1, true) then
                task.wait(0.1)
                c:Destroy()
            end
        end)
    end)

    VH.stage("C", "prelude done")
end)()

